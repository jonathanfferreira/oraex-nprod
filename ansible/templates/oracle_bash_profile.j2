# .bash_profile for oracle user
# Generated by Ansible - Do not edit manually

export ORACLE_BASE={{ oracle_base | default('/u01/app/oracle') }}
export ORACLE_HOME={{ oracle_home }}
export ORACLE_SID={{ db_name | default('ORCL') | lower }}
export ORACLE_UNQNAME={{ db_name | default('ORCL') }}
export PATH=$ORACLE_HOME/bin:$PATH
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:$LD_LIBRARY_PATH
export NLS_LANG=AMERICAN_AMERICA.AL32UTF8
export NLS_DATE_FORMAT="YYYY-MM-DD HH24:MI:SS"

# Aliases úteis
alias sqlp='sqlplus / as sysdba'
alias lsnr='lsnrctl status'
alias alert='tail -100f $ORACLE_BASE/diag/rdbms/$(echo $ORACLE_SID | tr "[:upper:]" "[:lower:]")/$ORACLE_SID/trace/alert_$ORACLE_SID.log'
