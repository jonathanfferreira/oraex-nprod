oracle.install.responseFileVersion=/oracle/install/rspfmt_crsinstall_response_schema_v19.0.0
INVENTORY_LOCATION=/u01/app/oraInventory
ORACLE_BASE=/u01/app/grid

# Single Instance (Restart) vs RAC (Cluster)
{% if oracle_install_type == 'rac' %}
oracle.install.option=CRS_CONFIG
oracle.install.crs.config.clusterName=oraex-cluster
oracle.install.crs.config.gpnp.scanName=oraex-scan
oracle.install.crs.config.gpnp.scanPort=1521
oracle.install.crs.config.clusterNodes=rac-node1:rac-node1-vip,rac-node2:rac-node2-vip
{% else %}
oracle.install.option=HA_CONFIG
{% endif %}

# ASM Groups
oracle.install.asm.OSDBA=asmdba
oracle.install.asm.OSOPER=asmoper
oracle.install.asm.OSASM=asmadmin

# Passwords
oracle.install.asm.SYSASMPassword={{ sys_asm_pass }}
oracle.install.asm.monitorPassword={{ asm_snmp_pass }}

# ASM Disk Group (DATA) using Loopback (Clean Install) or Real Disks
oracle.install.asm.diskGroup.name={{ asm_dg_name }}
oracle.install.asm.diskGroup.redundancy={{ asm_dg_redundancy }}
oracle.install.asm.diskGroup.AUSize={{ asm_au_size }}
# Discovery String for Lab (Loopback) or Prod (Generic)
oracle.install.asm.diskGroup.disks={{ asm_disk }}
oracle.install.asm.diskGroup.diskDiscoveryString={{ asm_discovery_string }}

oracle.install.asm.configureAFD=false
oracle.install.config.managementOption=NONE
