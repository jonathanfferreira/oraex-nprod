# =============================================================================
# ORAEX Environment Variables
# -----------------------------------------------------------------------------
# Copie este arquivo para .env e configure os valores:
#   cp .env.example .env
# =============================================================================

# Oracle Database Connection
ORACLE_DSN=oracle:1521/orcl
ORACLE_USER=system
ORACLE_PASSWORD=your_secure_password_here

# Webhook Receiver
WEBHOOK_PORT=5001
WEBHOOK_SECRET=your_hmac_secret_here
RUNBOOK_TIMEOUT=300

# Oracle Client (opcional, para Windows/dev local)
# ORACLE_CLIENT_PATH=C:\oracle\instantclient_19_29

# Grafana
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here

# AlertManager SMTP (opcional)
# SMTP_SMARTHOST=smtp.example.com:587
# SMTP_FROM=alertmanager@oraex.local
# SMTP_AUTH_USERNAME=alertmanager@oraex.local
# SMTP_AUTH_PASSWORD=your_smtp_password_here

# Slack (opcional)
# SLACK_API_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
