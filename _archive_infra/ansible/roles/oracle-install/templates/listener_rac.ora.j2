# ==============================================================================
# LISTENER.ORA para Oracle RAC
# ==============================================================================
# Gerado automaticamente pelo Ansible - Role oracle-install
# ==============================================================================

LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ ansible_hostname }})(PORT = 1521))
      (ADDRESS = (PROTOCOL = IPC)(KEY = EXTPROC1521))
    )
  )

SID_LIST_LISTENER =
  (SID_LIST =
    (SID_DESC =
      (SID_NAME = {{ oracle_sid | default('orcl') }})
      (ORACLE_HOME = {{ oracle_home }})
    )
  )

ADR_BASE_LISTENER = {{ oracle_base }}/diag
