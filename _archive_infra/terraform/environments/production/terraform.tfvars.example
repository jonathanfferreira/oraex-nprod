# ==============================================================================
# Variáveis de Ambiente - PRODUÇÃO
# ==============================================================================
# Copiar para terraform.tfvars e preencher com valores reais
# NUNCA commitar terraform.tfvars com valores reais no Git!
# ==============================================================================

# vSphere
vsphere_user                 = "administrator@vsphere.local"
vsphere_password             = "CHANGE_ME"
vsphere_server               = "vcenter.getnet.com.br"
vsphere_allow_unverified_ssl = false

# Ambiente
environment = "prod"
project_name = "ORAEX"

# Recursos vSphere (Produção)
prod_resource_pool_id    = "Production/DB-Servers"
prod_datastore_id        = "PROD-DS-01"
prod_shared_datastore_id = "PROD-SHARED-DS-01"
prod_network_id          = "PROD-DB-NETWORK"

# Tags
tags = {
  Project     = "ORAEX"
  Environment = "production"
  Team        = "DBRE"
  CostCenter  = "IT-INFRA"
}
