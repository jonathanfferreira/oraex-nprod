# ==============================================================================
# Configuração de Backend Remoto - Terraform
# ==============================================================================
# Copiar para backend.hcl e preencher com valores reais
# NUNCA commitar backend.hcl com valores reais no Git!
# ==============================================================================

bucket         = "getnet-terraform-state"
key            = "oraex/production/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "terraform-state-lock"
encrypt        = true

# Opcional: Profile AWS
# profile = "getnet-prod"
